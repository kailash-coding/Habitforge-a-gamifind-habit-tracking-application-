PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/habitforge
MONGO_URI=mongodb://127.0.0.1:27017/habitforge

# Email OTP (optional — without these, OTP is printed in the server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=HabitForge <your-email@gmail.com>
